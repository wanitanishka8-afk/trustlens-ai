# TrustLens AI Environment Configuration
# Copy this file to .env and fill in your values. Do NOT commit .env to version control.

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Google Gemini API Key (Backend-only. Get yours at https://aistudio.google.com/)
# If left blank, TrustLens AI seamlessly operates in "Local rules-only analysis" mode.
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database Path
DATABASE_PATH=./data/trustlens.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60
